{
  "manifest_version": 3,
  "name": "TCG Trade-In Sheet",
  "description": "Averages TCGplayer latest sales per printing and grade, converts to CAD, exports a trade-in sheet.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://mpapi.tcgplayer.com/*",
    "https://open.er-api.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tcgplayer.com/product/*"],
      "js": ["content.js"]
    }
  ]
}
